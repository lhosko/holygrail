# ./setup.sh writes .env from this file and asks for GATEWAY_API_KEY (docs/QUICKSTART.md).
# By hand: cp example.env .env (gitignored). Config and guardrail ids are the shared lhoskinson-us demo workspace (docs/SCM-SETUP.md section 5).

# --- SCM AI Gateway (hybrid data plane on local K8s) ---
GATEWAY_URL=http://host.docker.internal:8787
GATEWAY_API_KEY=
CONFIG_L1=pc-storm-5975e2
CONFIG_L2=pc-storm-9e79bd
CONFIG_L3=pc-storm-0ed97d
# Guardrail ids, used only to label which check fired in the UI
GUARDRAIL_TOXIC_ID=pg-storm-ac3c51
GUARDRAIL_REGEX_ID=pg-storm-c62a8b
GUARDRAIL_AIRS_ID=pg-storm-ebf413

# --- Guard's tools: taunts MCP server behind the gateway's MCP port (docs/SCM-SETUP.md section 7) ---
# Set MCP_TAUNTS=0 to go back to one LLM call per turn with no tools.
MCP_TAUNTS=1
MCP_GATEWAY_URL=http://host.docker.internal:8788
MCP_SERVER_SLUG=storm-castle-taunts

# --- Red teaming (docs/RED-TEAM.md) ---
# Bearer token for POST /api/redteam, the Prisma AIRS AI Red Teaming target. Empty = route off (keep it off at the booth).
#   echo "REDTEAM_TOKEN=$(openssl rand -hex 24)" >> .env
REDTEAM_TOKEN=
REDTEAM_MAX_IN_FLIGHT=2

# --- Model (Docker Model Runner) ---
MODEL=ai/llama3.1:8B-Q4_K_M
# Confirm tags with `docker model pull <tag>`; the staff page switches between these live.
MODEL_CHOICES=ai/llama3.1:8B-Q4_K_M,ai/mistral:7B-Q4_K_M,ai/gemma3:4b-q4_K_M,ai/gemma4:e4b-q4_K_M,ai/gemma4:12b-q4_K_M

# --- Minecraft ---
MC_VERSION=1.21.4
RCON_PASSWORD=change-me-rcon
# Your Minecraft username on the TV client (becomes the spectator camera)
CAMERA_PLAYER=

# --- Booth ---
STAFF_PIN=1234
BRIDGE_OPEN_SECONDS=10
# 1 = prismarine-viewer backup on :3007
VIEWER=0

# Emergency only: 1 = skip the gateway and call Docker Model Runner directly (NO guardrails at any level).
# The UI shows a red GATEWAY BYPASSED badge while this is on.
DIRECT_MODEL=0
